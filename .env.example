# Vórtex Rastreio — variáveis de ambiente.
# Copie para .env.local (no seu computador) ou cadastre na Vercel (Settings › Environment Variables).
# Nunca versione .env.local nem cole estes valores em chat.
# Sem DATABASE_URL e sem as chaves do Supabase o app roda em MODO LOCAL: banco PGlite em .data/,
# usuário de desenvolvimento, sem login (só fora de produção).

# Conexão com o Postgres do seu projeto Supabase usando a role DEDICADA do app (nunca postgres/service_role).
# Gerada por scripts/gerar-env-producao.mjs (produção, role rastro_app_prod) ou scripts/setup-credentials.mjs (dev, rastro_app).
# Formato (pooler em modo transação, porta 6543): postgresql://rastro_app_prod.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Auth (login do painel). Project Settings › API Keys. A chave anon/publishable é pública por natureza.
# URL no formato https://SEU-PROJETO.supabase.co (deixe vazio no .env.local para rodar em modo local).
NEXT_PUBLIC_SUPABASE_URL=
# Os scripts de credenciais leem esta chave daqui do .env.local.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 32 bytes em base64 para cifrar os tokens das integrações (Kiwify, Meta). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde bem: se trocar, os tokens já salvos ficam ilegíveis e precisam ser salvos de novo.
ENCRYPTION_KEY=

# Protege as rotas /api/cron/* (a Vercel manda Authorization: Bearer <valor> sozinha). Qualquer texto longo e aleatório.
CRON_SECRET=

# Versão da API de anúncios da Meta (opcional; padrão v23.0)
META_API_VERSION=v23.0

# Liga a conexão com a Meta Ads (salvar token e sincronizar investimento). 1 = ligado. Opcional.
# RASTRO_ENABLE_META=1

# Ids (UUID do Supabase › Authentication › Users) de quem pode usar o Laboratório em produção, separados por vírgula. Opcional.
# RASTRO_LAB_ADMIN_IDS=

# Nome do produto exibido no painel (opcional; padrão "Vórtex Rastreio"). Lido no build.
# NEXT_PUBLIC_BRAND_NAME=Vórtex Rastreio

# Só no seu computador: força o banco local e ignora o Supabase mesmo com este arquivo preenchido. Opcional.
# RASTRO_LOCAL=1
